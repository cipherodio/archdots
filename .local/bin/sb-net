#!/bin/sh
# Author: cipherodio
# Description: Internet status for dwmblocks
notif_guide="🌐 Internet module
- Left: connect
- Right: show SSID
❌: wifi disabled
📡: no wifi
📶: wifi quality
⚠: connected but no internet
❎: no ethernet
🌐: ethernet"
case "$BLOCK_BUTTON" in
1) ssidnotify ;;
2) notify-send "$notif_guide" ;;
3)
    setsid -f "$TERMINAL" -e nmtui
    pkill -RTMIN+4 i3blocks 2>/dev/null
    ;;
esac

check_internet() {
    curl -sf -m 2 --connect-timeout 2 -o /dev/null \
        "http://connectivitycheck.gstatic.com/generate_204" 2>/dev/null
}

wifiicon=""
ethericon=""
link_up=0

# Wifi
for dev in /sys/class/net/w*; do
    [ -e "$dev" ] || continue
    read -r operstate <"$dev/operstate" 2>/dev/null
    if [ "$operstate" = "up" ]; then
        link_up=1
        quality=$(awk -v dev="$(basename "$dev")" '
            $1 ~ dev ":" { print int($3) }
        ' /proc/net/wireless)
        if [ -n "$quality" ] && [ "$quality" -gt 0 ] 2>/dev/null; then
            percent=$((quality * 100 / 70))
            wifiicon="📶${percent}%"
        else
            wifiicon="📶"
        fi
    elif [ "$operstate" = "down" ]; then
        read -r flags <"$dev/flags" 2>/dev/null
        if [ "$flags" = "0x1003" ]; then
            wifiicon="📡"
        else
            wifiicon="❌"
        fi
    fi
done

# Ethernet
for dev in /sys/class/net/e*; do
    [ -e "$dev" ] || continue
    read -r operstate <"$dev/operstate" 2>/dev/null
    if [ "$operstate" = "up" ]; then
        link_up=1
        ethericon="🌐"
    elif [ -z "$wifiicon" ] || [ "$wifiicon" = "❌" ]; then
        ethericon="❎"
    fi
done

# Only probe if some link is actually up — no point checking internet
# when we already know there's no link at all
if [ "$link_up" -eq 1 ]; then
    if ! check_internet; then
        [ -n "$wifiicon" ] && wifiicon="${wifiicon}⚠"
        [ "$ethericon" = "🌐" ] && ethericon="${ethericon}⚠"
    fi
fi

printf "%s%s\n" "$wifiicon" "$ethericon"
