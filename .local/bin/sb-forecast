#!/bin/sh
cache="$HOME/.cache/weatherstatus"
weatherreport="$HOME/.cache/weatherreport"

case "$BLOCK_BUTTON" in
3) setsid -f "$TERMINAL" -e less -Sf "$weatherreport" ;;
esac

if json=$(curl -sf --connect-timeout 5 --max-time 10 "wttr.in/$LOCATION?format=j1" 2>/dev/null); then
    weather=$(printf '%s' "$json" | jq -r '
        .current_condition[0] as $c
        | .weather[0].hourly[0] as $h
        | "🌞+\($c.temp_C)(\($c.FeelsLikeC))°C 🍃\($c.winddir16Point) \($c.windspeedKmph) km/h ☔\($h.chanceofrain)%"
    ' 2>/dev/null)
    if [ -n "$weather" ]; then
        printf ' %s\n' "$weather" >"$cache"
        curl -sf --connect-timeout 5 --max-time 10 "wttr.in/$LOCATION" >"$weatherreport" 2>/dev/null
    fi
fi

[ -r "$cache" ] && cat "$cache"
